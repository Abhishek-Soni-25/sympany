{
  "name": "sympany-socmon-build",
  "description": "Builds the Sympany social listening image from the release zip and pushes it to ECR",
  "source": {
    "type": "S3",
    "location": "sympany-socmon-releases-123456789012/sympany-socmon-release.zip",
    "buildspec": "buildspec.yml"
  },
  "artifacts": {"type": "NO_ARTIFACTS"},
  "environment": {
    "type": "LINUX_CONTAINER",
    "image": "aws/codebuild/amazonlinux-x86_64-standard:5.0",
    "computeType": "BUILD_GENERAL1_MEDIUM",
    "privilegedMode": true,
    "environmentVariables": [
      {"name": "ECR_REPOSITORY_URI", "value": "123456789012.dkr.ecr.eu-central-2.amazonaws.com/sympany-socmon", "type": "PLAINTEXT"},
      {"name": "CONTAINER_NAME", "value": "web", "type": "PLAINTEXT"}
    ]
  },
  "serviceRole": "<CODEBUILD_ROLE_ARN>",
  "timeoutInMinutes": 30,
  "logsConfig": {"cloudWatchLogs": {"status": "ENABLED", "groupName": "/aws/codebuild/sympany-socmon-build"}}
}
