# LOCAL DEVELOPMENT: copy to .env and fill in. NEVER commit or zip .env.
# On AWS this file is not used: secrets live in SSM Parameter Store and the settings
# below are environment variables on the ECS task definitions (see DEPLOY.md).

# --- Run locally (files under data/, scans in-process) ---
# AI always uses Amazon Bedrock + Amazon Transcribe in eu-central-2, so a local run needs AWS
# credentials (e.g. `aws configure` / AWS_PROFILE) with access to the two Qwen models.
STORAGE_BACKEND=local
AUTH_MODE=none                  # or "password" to test the sign-in screen (needs the two below)
SCAN_LAUNCH=local
AWS_REGION=eu-central-2
# AWS_PROFILE=

# --- Dashboard sign-in (AUTH_MODE=password) ---
# APP_USERS: output of `python -m tools.create_app_user <username>`
# SESSION_SECRET: any random string of 32+ characters, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
APP_USERS=
SESSION_SECRET=

# --- Media Compliance module (hidden by default) ---
FEATURE_MEDIA_COMPLIANCE=false

# --- Data collection (REQUIRED for live channels) ---
# Leave empty or PLACEHOLDER until the keys are available: those channels are then skipped.
# Bright Data Web Scraper — YouTube, Reddit, wider web/SERP (console -> API tokens)
BRIGHTDATA_API_KEY=
# Apify — Instagram, Facebook, Quora, YouTube Shorts actors (Settings -> API tokens)
APIFY_TOKEN=
# Instagram/Quora session cookies (optional; only some actors use them)
INSTAGRAM_SESSION_COOKIES=
QUORA_SESSION_COOKIES=

# Media Compliance — Video Link screening.
# YouTube serves captions to residential IPs but BLOCKS datacenter IPs (e.g. AWS
# Fargate behind a NAT gateway). Without this, a video link screened in production gets an empty transcript
# and routes to manual review, while the same link screened locally reads the
# transcript and screens fully. Set this to a residential proxy so production reads
# the same captions a local machine does. Format: http://user:pass@host:port
# (e.g. a Bright Data residential/Web-Unlocker zone endpoint). Leave blank for local.
YT_PROXY_URL=


# The variables below are only needed if you switch a channel to a real live connector
# (mode: live) or the legacy n8n webhook (mode: n8n).

# --- Telegram (MTProto) ---
# Obtain api_id / api_hash at https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=                 # login phone, e.g. +41791234567 (interactive code on first run)

# --- Reddit ---
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=social-media-surveillance/0.1 by your_reddit_username

# --- X / Twitter API v2 (paid tier required for search) ---
X_BEARER_TOKEN=

# --- LinkedIn (ToS-GATED unofficial scraper) ---
# WARNING: the linkedin-api library logs in with a real account and VIOLATES LinkedIn's
# User Agreement (account-ban + legal risk). Prefer a licensed provider. To enable anyway:
#   pip install linkedin-api   AND set linkedin channel to mode: live in config.yaml
LINKEDIN_TOS_ACK=false          # set to "true" to acknowledge the ToS/legal risk
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=
# (Compliant alternative) consented compliance-archive vendor feed:
LINKEDIN_ARCHIVE_ENDPOINT=
LINKEDIN_ARCHIVE_TOKEN=

# --- WhatsApp (authorized compliance-archive feed only) ---
WHATSAPP_ARCHIVE_ENDPOINT=
WHATSAPP_ARCHIVE_TOKEN=

# --- Quora (no API; licensed social-listening provider feed only) ---
QUORA_FEED_ENDPOINT=
QUORA_FEED_TOKEN=
